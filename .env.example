# Only needed for the one-time `npm run auth`. Omit to be prompted interactively.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Produced by `npm run auth`. Set this instead of a token file on Vercel.
GARMIN_TOKENS_BASE64=

# Optional. Defaults to ~/.garmin-mcp/tokens.json
GARMIN_TOKEN_PATH=


# --- Hosted remote MCP server (Vercel + Upstash) ---

# Upstash Redis. Without both of these the OAuth endpoints refuse to run, and
# token storage falls back to the local file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs MCP access tokens. 32+ random bytes; rotating it revokes every session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=


# Google sign-in. Create an OAuth client (type: Web application) at
# console.cloud.google.com, and add this as an authorised redirect URI:
#   https://YOUR-APP.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may use this deployment, comma separated. Anyone not listed is refused
# after sign-in. Leaving it empty blocks everyone rather than allowing everyone.
ALLOWED_EMAILS=you@gmail.com,dad@gmail.com

# Invite codes let a group self-serve without you adding each address to
# ALLOWED_EMAILS and redeploying. Comma-separated, 8+ characters each; shorter
# ones are ignored. Share as https://your-app.vercel.app/connect?invite=CODE
# Redeeming records the address, so nobody needs the code twice.
INVITE_CODES=

# Ceiling on invite redemptions. A code shared in a group chat travels further
# than intended, and every extra person is another set of health credentials you
# are responsible for. Defaults to 25. ALLOWED_EMAILS is not counted.
MAX_USERS=

# Open sign-up: any Google account with a verified email may join, no invite.
# Off unless set to exactly "true", so a deployment is never open by accident.
# ALLOWED_EMAILS and INVITE_CODES keep working alongside it.
# MAX_USERS still applies — set it to "unlimited" to remove the ceiling.
OPEN_SIGNUP=
