# Only needed for the one-time `npm run auth`. Omit to be prompted interactively.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Produced by `npm run auth`. Set this instead of a token file on Vercel.
GARMIN_TOKENS_BASE64=

# Optional. Defaults to ~/.garmin-mcp/tokens.json
GARMIN_TOKEN_PATH=

# Vercel token extractor only. The /api/token endpoint refuses every request
# until this is set to 16+ random characters, so an unconfigured deployment
# cannot be used as a credential-harvesting page. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_GATE_SECRET=

# --- Hosted remote MCP server (Vercel + Upstash) ---

# Upstash Redis. Without both of these the OAuth endpoints refuse to run, and
# token storage falls back to the local file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs MCP access tokens. 32+ random bytes; rotating it revokes every session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# The only credential between the internet and your health data. Minimum 16
# characters, and it is rate limited to 8 attempts per 15 minutes per IP.
ADMIN_PASSWORD=
